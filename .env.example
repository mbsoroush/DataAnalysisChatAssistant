# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio

# Model names are configurable because names and free-tier limits change.
# Run scripts/smoke_test.py to list the models your key can use.
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro

# Your Google Cloud project ID (queries run, and are billed/quota'd, here)
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=bigquery-public-data.thelook_ecommerce
