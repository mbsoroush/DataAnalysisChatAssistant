# Copy this file to .env and fill in the values marked CHANGE_ME. Never commit .env.
GEMINI_API_KEY=CHANGE_ME

# Model names are configurable because names and free-tier limits change.
# Run scripts/smoke_test.py (or scripts/probe_models.py) to list the models your key can use.
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
# Comma-separated models tried in order when the primary is rate-limited or down.
GEMINI_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest
# Which model writes the SQL: "fast" or "strong".
SQL_MODEL_TIER=strong
# Per-call time limit in seconds before failing over to the next model.
LLM_TIMEOUT_S=40

# Your Google Cloud project ID (queries run, and are billed/quota'd, here).
GCP_PROJECT_ID=CHANGE_ME
BQ_DATASET=bigquery-public-data.thelook_ecommerce
# Server-side cap on bytes a single query may bill (1 GB).
MAX_BYTES_BILLED=1000000000

# Salt for customer-id pseudonyms. Pick any long random string.
PII_SALT=CHANGE_ME
# User from config/user_access.yaml used when --user is not given.
DEFAULT_USER=exec_brands

# Optional paths (defaults shown).
# TRACE_FILE=logs/traces.jsonl
# REPORTS_DB=data/reports.db
